# Copy to .env and generate independent random values for both keys.
NEXORA_SECRET_KEY=
NEXORA_CREDENTIAL_KEY=
# Rotation: increment the active version and retain old `version:base64` keys temporarily.
NEXORA_CREDENTIAL_ACTIVE_KEY_VERSION=1
NEXORA_CREDENTIAL_PREVIOUS_KEYS=

NEXORA_HTTP_PORT=8000
NEXORA_IMAGE=nexora:latest
NEXORA_LIBRARY_HOST_PATH=/mnt/nexora-library
NEXORA_LOG_LEVEL=INFO
NEXORA_METRICS_SAMPLE_INTERVAL_SECONDS=360
# Exact remote directories allowed for VM sharing, comma separated. Empty denies all.
NEXORA_SHARED_DIRECTORY_ROOTS=
NEXORA_TRUSTED_HOSTS=localhost,127.0.0.1
# Origin reachable from managed KVM nodes; required for platform HTTP ISO mounting.
NEXORA_MEDIA_PUBLIC_BASE_URL=
# Keep true behind HTTPS. Set false only for isolated HTTP development.
NEXORA_SESSION_COOKIE_SECURE=true
